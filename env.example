# ---- Puente de Apps Script (ver apps-script/Backend.gs y el README) ----
# Dirección /exec de la implementación como aplicación web
APPS_SCRIPT_URL=
# Texto largo y aleatorio. Debe ser IGUAL a la propiedad del script API_SECRET en Apps Script
API_SECRET=

# ---- Acceso y seguridad ----
# Clave para entrar al panel y al dashboard
CLAVE_PANEL=
# Texto largo y aleatorio: firma los enlaces "Abrir Ticket" de los técnicos
TOKEN_SECRET=
# Vercel lo envía al ejecutar la revisión automática de alertas (texto largo y aleatorio)
CRON_SECRET=

# ---- Opcionales ----
# Correo que recibe copia de las alertas y los casos sin técnico
CORREO_ADMIN=
# URL pública del sitio (si no se define se usa la del dominio de Vercel que recibe la petición)
URL_APP=
# Cada cuántos minutos corre la revisión automática (solo para el texto del dashboard; por defecto 1440)
ALERTAS_CADA_MINUTOS=1440
